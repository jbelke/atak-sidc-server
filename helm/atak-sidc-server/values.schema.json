{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "atak-sidc-server chart values",
  "description": "Deliberately permissive: it type-checks the values people actually get wrong and otherwise stays out of the way (additionalProperties is allowed everywhere), so adding a value does not mean editing this file.",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "3 by default; below 3 also lower podDisruptionBudget.minAvailable."
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "containerPorts": {
      "type": "object",
      "required": ["http", "pm2"],
      "properties": {
        "http": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "pm2": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "secondary": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" },
        "pathType": { "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    },
    "env": { "type": "object" },
    "secretEnv": { "type": "object" },
    "extraEnv": { "type": "array" },
    "envFrom": { "type": "array" },
    "podDisruptionBudget": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 }
      }
    },
    "topologySpreadConstraints": { "type": "array" },
    "tolerations": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" },
    "healthPath": { "type": "string", "pattern": "^/" }
  }
}
